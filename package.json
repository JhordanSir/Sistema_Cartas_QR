{
  "name": "sirio-cartas-qr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.1.0"
  },
  "scripts": {
    "build": "pnpm db:generate && pnpm -r --workspace-concurrency=1 --if-present build",
    "dev": "pnpm --parallel --filter @sirio/api --filter @sirio/web dev",
    "lint": "pnpm -r --if-present lint",
    "check:dead-code": "knip --include files --include dependencies --include exports --include types",
    "typecheck": "pnpm db:generate && pnpm -r --if-present typecheck",
    "test": "pnpm db:generate && pnpm -r --if-present test",
    "test:coverage": "pnpm db:generate && pnpm -r --if-present test:coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed:admin": "pnpm db:generate && pnpm --filter @sirio/api seed:admin",
    "compose:config": "docker compose --env-file .env config --quiet",
    "compose:up": "docker compose --env-file .env up -d --build --wait",
    "compose:down": "docker compose --env-file .env down",
    "compose:dev": "docker compose --env-file .env -f compose.yml -f compose.dev.yml up -d --build --wait",
    "compose:dev:down": "docker compose --env-file .env -f compose.yml -f compose.dev.yml down"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "dotenv": "17.4.2",
    "knip": "6.34.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3"
  }
}
