# Copy to .env for local development (`pnpm dev:netlify` loads it).
# In Netlify, set the same variables under Project configuration → Environment variables.

# Public origin the QR codes point to. Must be the final address before any restaurant opens its QR page.
PUBLIC_APP_URL=https://sirio-cartas.netlify.app

# Google AI Studio key for menu digitization (phase 10).
SIRIO_GEMINI_API_KEY=

# Optional: Gemini model; defaults to gemini-2.5-flash. Google only serves the 2.5 line
# to accounts that already used it: if every digitization fails with a configuration
# error, try the current Flash model shown in AI Studio (for example gemini-3.8-flash).
GEMINI_MODEL=

# Local only: 1 replaces Gemini with the simulated extractor of the end-to-end tests.
# Playwright sets it when it starts `netlify dev`; it has no effect in Netlify.
# DIGITIZATION_FAKE=1

# 64 random hex characters used to hash visitor IPs (phase 11). Example: openssl rand -hex 32
VIEW_HASH_SECRET=
