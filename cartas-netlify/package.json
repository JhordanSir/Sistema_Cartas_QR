{
  "name": "cartas-netlify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:netlify": "node scripts/netlify-cli.ts dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:local:apply": "node scripts/local-db.ts apply",
    "db:local:reset": "node scripts/local-db.ts reset",
    "cli:netlify": "node scripts/netlify-cli.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.1",
    "@netlify/database": "^2.0.1",
    "drizzle-orm": "1.0.0-rc.4",
    "hash-wasm": "^4.12.0",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@netlify/database-dev": "1.0.1",
    "@netlify/functions": "^6.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "netlify-cli": "^27.10.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.1.1"
}
