# Copia este archivo como .env en la raiz. No confirmes .env en Git.
# Mantén POSTGRES_PASSWORD URL-safe porque también forma parte de las URLs.

NODE_ENV=development

# PostgreSQL
POSTGRES_DB=cartas_qr
POSTGRES_USER=cartas_qr
POSTGRES_PASSWORD=replace-with-a-url-safe-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cartas_qr:replace-with-a-url-safe-password@localhost:5432/cartas_qr?schema=public
DATABASE_URL_DOCKER=postgresql://cartas_qr:replace-with-a-url-safe-password@postgres:5432/cartas_qr?schema=public

# Servicios
API_PORT=3001
WEB_PORT=3000
WEB_BIND_ADDRESS=127.0.0.1
PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
API_INTERNAL_URL_DOCKER=http://api:3001
CORS_ORIGINS=http://localhost:3000
STORAGE_PATH=./storage
APP_TIMEZONE=America/Lima
TZ=UTC
LOG_LEVEL=info

# Autenticacion
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=sirio-cartas-qr
JWT_AUDIENCE=sirio-cartas-qr-api
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Privacidad de estadisticas (se usa en la Fase 7)
VIEW_IP_HASH_SECRET=replace-with-at-least-32-random-characters

# Gemini (se usa en la Fase 4)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=2
