    "test:coverage": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@sirio/shared": "workspace:*",
    "dotenv": "17.4.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
